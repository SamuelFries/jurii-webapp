# Copie para .env.local e preencha. Na Vercel, configure em
# Settings > Environment Variables (projeto do dominio app.jurii.com.br).

# Público por desenho: é a MESMA publishable key que vai no binário do app
# Flutter. A segurança vem da RLS, não do sigilo desta chave.
NEXT_PUBLIC_SUPABASE_URL=https://rlgtgipxltucrtkyrmag.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Pagamento
# ---------------------------------------------------------------------------
#
# Sem PAGAMENTOS_PROVEDOR=asaas nada de cobrança é oferecido: as telas não
# mostram botão de pagar e o webhook responde 501. É proposital, para que um
# ambiente meio configurado não ofereça um botão que leva a lugar nenhum.
PAGAMENTOS_PROVEDOR=asaas

# A chave da conta Asaas. A de SANDBOX começa com $aact_hmlg_ e a de PRODUÇÃO
# com $aact_prod_. Elas não são intercambiáveis, e a de produção não deve
# passar por chat, ticket ou repositório: ela vai direto para a Vercel.
ASAAS_API_KEY=$aact_...

# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3  (é o padrão quando a variável falta)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# O token que o Asaas manda no header `asaas-access-token` de cada webhook.
# A PRÓPRIA API recusa menos de 32 caracteres. Gere um aleatório e cadastre o
# mesmo valor em Asaas > Integrações > Webhooks.
#
# Ele NÃO é o que segura a porta: o webhook re-consulta a cobrança na API
# antes de aplicar qualquer efeito, então corpo forjado sobre uma cobrança não
# paga não ativa nada. O token só evita o barulho.
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# A service_role
# ---------------------------------------------------------------------------
#
# SEM PREFIXO NEXT_PUBLIC_, e isso não é estilo: com o prefixo o Next embute o
# valor no pacote do navegador e a chave que ignora toda a RLS fica no HTML de
# qualquer visitante.
#
# QUEM USA: o webhook de pagamento, e só ele. É a única rota que ninguém
# autentica, então não tem sessão para agir em nome de alguém, e ainda assim
# precisa mover assinatura para 'active'. E mesmo ela não escreve à toa: a
# única coisa que chama é aplicar_efeito_de_pagamento, que valida a transição.
SUPABASE_SERVICE_ROLE_KEY=
