# Copie para .env.local e preencha. Na Vercel, configure em
# Settings > Environment Variables (projeto do dominio app.jurii.com.br).

# Público por desenho: é a MESMA publishable key que vai no binário do app
# Flutter. A segurança vem da RLS, não do sigilo desta chave.
NEXT_PUBLIC_SUPABASE_URL=https://rlgtgipxltucrtkyrmag.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NUNCA crie aqui uma variável NEXT_PUBLIC_ com a service_role. O prefixo
# NEXT_PUBLIC_ manda o valor para o navegador de todo mundo. Quando o webhook
# de pagamento existir, a service_role entra SÓ na Vercel, sem prefixo:
# SUPABASE_SERVICE_ROLE_KEY=  (somente na Vercel, somente para o webhook)
